# --- PostgreSQL ---
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=db
# Port di dalam jaringan Docker (dipakai Django/Celery)
POSTGRES_PORT=5432
# Port di laptop (host), terikat ke 127.0.0.1
POSTGRES_HOST_PORT=15432

# --- Port host lain ---
NGINX_HOST_PORT=8080
S3_HOST_PORT=8333
# Kotak masuk Mailpit (email uji) di http://localhost:8025
MAILPIT_HOST_PORT=8025

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origin frontend (Vite), dipisah koma
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Origin akses lewat nginx (login Django Admin), dipisah koma
CSRF_TRUSTED_ORIGINS=http://localhost:8080
# Alamat halaman pembeli (tujuan "Lihat situs" di Django Admin; kosong = http://localhost:5173)
FRONTEND_URL=
# Sesi Django Admin berakhir setelah sekian menit tanpa aktivitas (kosong = 30)
ADMIN_SESI_TIDAK_AKTIF_MENIT=

# --- Email (notifikasi pembeli, atur ulang kata sandi) ---
# Kosong = Mailpit di Docker (host mailpit, port 1025, tanpa TLS): semua email tertangkap di
# http://localhost:8025 dan tidak terkirim ke internet. Untuk email sungguhan lewat Gmail:
# EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True, EMAIL_HOST_USER=<alamat Gmail>,
# EMAIL_HOST_PASSWORD=<sandi aplikasi 16 huruf dari myaccount.google.com/apppasswords>,
# DEFAULT_FROM_EMAIL=Polibatam Press <alamat Gmail yang sama>. Jangan pernah commit nilai ini.
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# False = notifikasi hanya tampil di aplikasi, tidak dikirim ke email
EMAIL_NOTIFIKASI_AKTIF=True

# --- Celery ---
# Skema redis:// dipakai karena Valkey kompatibel dengan protokol Redis
CELERY_BROKER_URL=redis://broker:6379/0
CELERY_RESULT_BACKEND=redis://broker:6379/1

# --- Object storage (SeaweedFS, S3) ---
S3_ENDPOINT_URL=http://storage:8333
# Harus memakai S3_HOST_PORT yang sama
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=polibatam-press

# --- Midtrans (sandbox: dashboard.sandbox.midtrans.com → Settings → Access Keys) ---
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=False
# Metode pembayaran di Snap, dipisah koma (kosong = other_qris, yaitu QRIS)
MIDTRANS_ENABLED_PAYMENTS=

# --- Checkout dan pengiriman (kosong = nilai bawaan di settings.py) ---
# Batas bayar setelah checkout dalam menit (bawaan 60); stok buku cetak dipesan selama itu
BATAS_BAYAR_MENIT=
# Ongkir tetap delivery area Kota Batam dalam rupiah (bawaan 15000, tarif sementara)
ONGKIR_KOTA_BATAM=
# Lokasi pengambilan takeaway (bawaan: Gedung TA Kampus Polibatam, Lantai 1 (Kantor Polibatam Store))
LOKASI_TAKEAWAY=

# --- Enkripsi dan DRM ---
FERNET_MASTER_KEY=
# Rahasia HMAC kode watermark ebook (nilai acak panjang, berbeda dari kunci lain)
WATERMARK_SECRET=
# Umur sesi streaming audiobook (menit)
STREAMING_SESSION_MINUTES=10
